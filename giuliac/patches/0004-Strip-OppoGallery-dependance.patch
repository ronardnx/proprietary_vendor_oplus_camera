+    # Build a clean ACTION_VIEW intent (standard Android gallery launch)
+    new-instance v0, Landroid/content/Intent;
+
+    const-string v1, "android.intent.action.VIEW"
+
+    invoke-direct {v0, v1}, Landroid/content/Intent;-><init>(Ljava/lang/String;)V
+
+    # Set MIME type based on whether it is a video (p2) or image
+    if-eqz p2, :cond_image
+
+    const-string v1, "video/*"
+
+    goto :goto_setdata
+
+    :cond_image
+    const-string v1, "image/*"
+
+    :goto_setdata
+    # Set the content URI and MIME type
+    invoke-virtual {v0, p3, v1}, Landroid/content/Intent;->setDataAndType(Landroid/net/Uri;Ljava/lang/String;)Landroid/content/Intent;
+
+    # Add FLAG_GRANT_READ_URI_PERMISSION so the gallery can read the file
+    const/4 v1, 0x1
+
+    invoke-virtual {v0, v1}, Landroid/content/Intent;->addFlags(I)Landroid/content/Intent;
+
+    # Get the activity and launch
+    iget-object v1, p0, Lcom/oplus/camera/helper/GalleryHelper;->a:Landroid/app/Activity;
+
+    invoke-virtual {v1, v0}, Landroid/app/Activity;->startActivity(Landroid/content/Intent;)V
+
     return-void
